PREVIEW_REPO = os.environ.get("CCDECK_REPO", "slonik923/ccdeck")
PREVIEW_PORT = 7798


def github_json(path):
    """GET api.github.com/<path>, through `gh` when it's installed (auth, private repos)."""
    if shutil.which("gh"):
        r = subprocess.run(["gh", "api", path], capture_output=True, text=True, timeout=30)
        if r.returncode == 0:
            return json.loads(r.stdout)
    import urllib.request
    req = urllib.request.Request("https://api.github.com/" + path, headers={"Accept": "application/vnd.github+json",
                                                                          "User-Agent": "ccdeck"})
    with urllib.request.urlopen(req, timeout=30) as f:
        return json.load(f)


def download_source(repo, sha, dest):
    """Download the repo at `sha` and unpack it into dest."""
    import urllib.request
    data = None
    if shutil.which("gh"):
        r = subprocess.run(["gh", "api", f"repos/{repo}/tarball/{sha}"], capture_output=True, timeout=120)
        data = r.stdout if r.returncode == 0 else None
    if data is None:
        req = urllib.request.Request(f"https://codeload.github.com/{repo}/tar.gz/{sha}", headers={"User-Agent": "ccdeck"})
        with urllib.request.urlopen(req, timeout=120) as f:
            data = f.read()
    unpack_tarball(data, dest)


def unpack_tarball(data, dest):
    """Unpack a GitHub tarball (one top folder) into dest. Only plain files and folders, inside dest."""
    import io
    import tarfile
    tmp = dest.with_name(dest.name + ".part")
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    root = tmp.resolve()
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
        for m in tar.getmembers():
            parts = m.name.split("/", 1)
            if len(parts) < 2 or not parts[1] or not (m.isfile() or m.isdir()):
                continue  # the top folder, links and devices
            target = (root / parts[1]).resolve()
            if root not in target.parents:
                raise RuntimeError(f"unsafe path in archive: {m.name}")
            if m.isdir():
                target.mkdir(parents=True, exist_ok=True)
            else:
                target.parent.mkdir(parents=True, exist_ok=True)
                with tar.extractfile(m) as src, open(target, "wb") as out:
                    shutil.copyfileobj(src, out)
                if m.mode & 0o100:
                    target.chmod(0o755)
    shutil.rmtree(dest, ignore_errors=True)
    tmp.rename(dest)


VERSION_RE = re.compile(r"v?(\d+\.\d+\.\d+)")


def version_at(repo, ref):
    """The ccdeck version (.claude-plugin/plugin.json) at a ref of repo, or None."""
    try:
        d = github_json(f"repos/{repo}/contents/.claude-plugin/plugin.json?ref={ref}")
        import base64
        return json.loads(base64.b64decode(d.get("content") or "")).get("version")
    except (OSError, ValueError, RuntimeError, AttributeError):
        return None


def find_version(version, repo):
    """What has ccdeck `version`: a tag, main, or an open PR (they don't share one: version-bumping PRs are
    stacked). Returns a target resolve_preview takes (a tag, "main", or "#N"), or None."""
    for tag in ("v" + version, version):
        try:
            if github_json(f"repos/{repo}/commits/{tag}").get("sha"):
                return tag
        except (OSError, ValueError, RuntimeError):
            pass
    if version_at(repo, "main") == version:
        return "main"
    try:
        prs = github_json(f"repos/{repo}/pulls?state=open&per_page=50")
    except (OSError, ValueError, RuntimeError):
        prs = []
    for pr in prs if isinstance(prs, list) else []:
        head = pr.get("head") or {}
        if ((head.get("repo") or {}).get("full_name") or "").lower() == repo.lower() \
                and version_at(repo, head.get("sha")) == version:
            return f"#{pr['number']}"
    return None


def resolve_preview(target, repo, trust):
    """(source folder, label) for a PR number, ccdeck version (0.8.5), branch, tag, commit, or local checkout."""
    if (m := VERSION_RE.fullmatch(target)) and not os.path.isdir(target):
        found = find_version(m.group(1), repo)
        if not found:
            sys.exit(f"No ccdeck {m.group(1)} in {repo}: not a tag, not on main, not in an open PR.")
        print(f"ccdeck {m.group(1)} is {'PR ' + found if found.startswith('#') else found}.")
        target = found
    if os.path.isdir(target):
        src = Path(target).resolve()
        if not (src / "ccdeck").is_file():
            sys.exit(f"{target} has no ccdeck script.")
        return src, f"local {src.name}"
    if target.lstrip("#").isdigit():
        pr = github_json(f"repos/{repo}/pulls/{target.lstrip('#')}")
        head, base = pr.get("head") or {}, pr.get("base") or {}
        head_repo = (head.get("repo") or {}).get("full_name") or "?"
        if head_repo.lower() != ((base.get("repo") or {}).get("full_name") or repo).lower() and not trust:
            sys.exit(f"PR #{pr.get('number')} comes from another repository ({head_repo}). "
                     "Its code would run on your machine: read it first, then pass --trust.")
        sha, label = head.get("sha"), f"#{pr.get('number')} {one_line(pr.get('title') or '', 60)}"
    else:
        sha = github_json(f"repos/{repo}/commits/{target}").get("sha")
        label = target
    if not sha:
        sys.exit(f"Couldn't find {target} in {repo}.")
    dest = PREVIEW_DIR / "src" / sha[:12]
    if not (dest / "ccdeck").is_file():
        print(f"Downloading {repo} at {sha[:12]}…")
        download_source(repo, sha, dest)
        olds = sorted((PREVIEW_DIR / "src").iterdir(), key=lambda p: p.stat().st_mtime)
        for old in olds[:-5]:  # keep the last few
            shutil.rmtree(old, ignore_errors=True)
    return dest, f"{label} ({sha[:7]})"


def preview_config_dir():
    """A Claude config folder that sees your transcripts and hook states but keeps its own caches."""
    cfg = PREVIEW_DIR / "claude"
    (cfg / "ccdeck").mkdir(parents=True, exist_ok=True)
    # sessions: Claude Code's registry of open sessions, which "Go to tab" and resume need
    for link, real in ((cfg / "projects", PROJECTS_DIR), (cfg / "ccdeck" / "state", STATE_DIR),
                       (cfg / "sessions", CLAUDE_DIR / "sessions")):
        real.mkdir(parents=True, exist_ok=True)
        real = real.resolve()  # a relative CLAUDE_CONFIG_DIR would make the link relative to the preview folder
        if link.is_symlink() or link.exists():
            if link.is_symlink() and os.readlink(link) == str(real):
                continue
            link.unlink() if link.is_symlink() or link.is_file() else shutil.rmtree(link)
        link.symlink_to(real)
    for real in (MARKS_FILE, CONFIG_FILE):  # copies: marks and settings changed in the preview don't change yours
        if real.exists():
            shutil.copy(real, cfg / "ccdeck" / real.name)
        else:  # none of yours: start without one, not with what the last preview changed
            (cfg / "ccdeck" / real.name).unlink(missing_ok=True)
    return cfg


def proc_zombie(pid):
    """pid has exited but its parent hasn't reaped it yet: its start time stays readable, but it's gone."""
    if USE_PROC:
        try:
            return _stat_fields(pid)[0] == "Z"
        except (OSError, IndexError, ValueError, TypeError):
            return False
    try:
        out = subprocess.run(["ps", "-o", "stat=", "-p", str(int(pid))], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        return False
    return out.strip().startswith("Z")


def stop_preview(quiet=False):
    """Stop the running preview and wait until it has (so its port is free). False if it wouldn't stop."""
    info = load_json(PREVIEW_DIR / "preview.json", {})
    pid, start = info.get("pid"), info.get("pid_start")
    if pid and not start:  # pid_alive(pid, None) accepts any process that has the pid now: don't signal it
        print(f"Can't tell whether pid {pid} is still the preview; if it is, stop it yourself.", file=sys.stderr)
        (PREVIEW_DIR / "preview.json").unlink(missing_ok=True)
        return False
    if not (pid and pid_alive(pid, start)):
        if not quiet:
            print("No preview is running.")
        (PREVIEW_DIR / "preview.json").unlink(missing_ok=True)
        return True
    for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 2)):
        try:
            os.kill(pid, sig)
        except OSError:
            pass
        running = lambda: pid_alive(pid, start) and not proc_zombie(pid)  # noqa: E731  a zombie has stopped
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline and running():
            time.sleep(0.1)
        if not running():
            break
    else:
        print(f"The preview (pid {pid}) didn't stop; stop it yourself, then try again.", file=sys.stderr)
        return False
    if not quiet:
        print(f"Stopped the preview of {info.get('label')}.")
    (PREVIEW_DIR / "preview.json").unlink(missing_ok=True)
    return True


def cmd_preview(args):
    """Stop and start go one at a time: two at once could both find the port free, and preview.json end up
    naming the one that failed, so `stop` couldn't stop the one running."""
    import fcntl
    PREVIEW_DIR.mkdir(parents=True, exist_ok=True)
    with open(PREVIEW_DIR / "preview.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # released when the file closes
        if args.target == "stop":
            return stop_preview()
        return start_preview(args)


def start_preview(args):
    try:
        src, label = resolve_preview(args.target, args.repo, args.trust)
    except (OSError, ValueError, RuntimeError) as e:  # network, GitHub or archive problems
        sys.exit(f"Couldn't get {args.target} from {args.repo}: {e}. "
                 "Install and log in to the GitHub CLI (gh auth login), or pass a local checkout.")
    if not stop_preview(quiet=True):
        sys.exit(1)
    try:
        knows_preview = "CCDECK_PREVIEW" in (src / "ccdeck").read_text(encoding="utf-8", errors="replace")
    except OSError:
        knows_preview = False
    if not knows_preview:  # it runs its own code, so it ignores what this version does for previews
        print(f"Note: {label} predates `ccdeck preview`. Its page has no preview tag, and if the ccdeck your\n"
              "hooks run is newer, it may switch itself to that version. Check the version in the page's header.")
    import socket
    with socket.socket() as sock:  # bound like the server binds it: free, or another program's
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("127.0.0.1", args.port))
        except OSError:
            sys.exit(f"Port {args.port} is in use by another program; pick another with --port.")
    cfg = preview_config_dir()
    env = dict(os.environ, CLAUDE_CONFIG_DIR=str(cfg), CCDECK_PREVIEW=label, CCDECK_NOTIFY="0", CCDECK_AUTOSTART="0",
               CCDECK_PREVIEW_SAVED_ENV=json.dumps({k: os.environ.get(k) for k in PREVIEW_ENV}))
    log = open(PREVIEW_DIR / "serve.log", "w")
    proc = subprocess.Popen([sys.executable, str(src / "ccdeck"), "serve", "--port", str(args.port)], env=env,
                            stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    start = None
    for _ in range(20):  # without /proc, ps is cached for a second and may predate the child: read it afresh
        _ps_cache["t"] = 0
        if (start := proc_start_time(proc.pid)) or proc.poll() is not None:
            break
        time.sleep(0.05)
    if not start:
        proc.terminate()
        sys.exit(f"The preview didn't start; see {short_path(PREVIEW_DIR / 'serve.log')}.")
    save_json(PREVIEW_DIR / "preview.json", {"pid": proc.pid, "pid_start": start, "port": args.port,
                                             "label": label, "source": str(src), "started": time.time()})
    import urllib.request
    url = f"http://localhost:{args.port}"
    deadline, up = time.monotonic() + 20, False  # the first scan can take a while (macOS: ps and lsof)
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            sys.exit(f"The preview stopped right away; see {short_path(PREVIEW_DIR / 'serve.log')}.")
        try:
            urllib.request.urlopen(url, timeout=0.5).close()
            up = True
            break
        except OSError:
            time.sleep(0.2)
    print(f"Preview of {label}: {url}" + ("" if up else "  (still starting)"))
    print("It reads your real sessions; notes, marks and settings you change there aren't kept. Stop it with: ccdeck preview stop")
    if not args.no_open:
        open_path(url)


# ------------------------------------------------------------------------ hook

# events that mean you acted on what the session's notification asked: you replied, or the prompt was
# answered (a tool ran or was denied), or the session ended. The dashboard's 2 s sweep can miss one: a
# prompt approved and the next one asked between two scans both read as "permission"
INBOX_ACTED = ("UserPromptSubmit", "PostToolUse", "PostToolUseFailure", "PermissionDenied", "SessionEnd")


def cmd_hook(_args):
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    if not isinstance(data, dict) or not data.get("session_id"):
        return
    sid = str(data["session_id"])
    if not re.fullmatch(r"[\w-]+", sid):
        return
    event = data.get("hook_event_name", "")
    path = STATE_DIR / f"{sid}.json"
    state = load_json(path, {})
    prev = state.get("status")
    if (event == state.get("event")
            and event not in ("PostToolUse", "PostToolUseFailure", "PermissionRequest")
            and time.time() - (state.get("ts") or 0) < 1.0):
        return  # same event twice (hooks installed both as a plugin and in settings.json)
    # A hook must exit fast: give ps 2 s here. If it can't say, the sender counts as interactive, as before.
    _ps_cache["timeout"] = 2
    sender = find_claude_ancestor()
    if pid_is_headless(sender):
        return  # a `claude -p` run (even `-p --resume <id>`): it never waits for you, and mustn't speak for the session
    state.update(session_id=sid, event=event, ts=time.time(),
                 cwd=data.get("cwd") or state.get("cwd"),
                 ccdeck={"version": VERSION, "script": str(SCRIPT)})  # lets a running dashboard upgrade itself
    if not pid_alive(state.get("pid"), state.get("pid_start")):
        if sender:
            state["pid"], state["pid_start"] = sender, proc_start_time(sender)

    if event == "SessionStart":
        state["status"] = "idle"
        refresh_stable_copy()
        autostart_daemon()
    elif event == "Stop":
        state["status"] = "stopped"
    elif event in ("UserPromptSubmit", "PostToolUse", "PostToolUseFailure"):
        state["status"] = "working"
        state.pop("message", None)
    elif event == "PermissionRequest":
        state["status"] = "permission"
        state["message"] = f"Claude wants to use {data.get('tool_name') or 'a tool'}"
    elif event == "PermissionDenied":
        state["status"] = "working"
    elif event == "SessionEnd":
        state["status"] = "ended"
        state["end_reason"] = data.get("reason")
    elif event == "Notification":
        ntype = str(data.get("notification_type") or "")
        msg = str(data.get("message") or "")
        state["message"] = msg
        low = f"{ntype} {msg}".lower()
        if "permission" in low:
            state["status"] = "permission"
        elif "elicitation" in low or "question" in low:
            state["status"] = "question"
        elif "idle" in low or "waiting for your input" in low:
            state["status"] = "idle"
        if (state.get("status") != prev and state.get("status") in ("permission", "question")
                and not daemon_running()):
            notify(f"Claude needs you · {short_path(state.get('cwd'))}", msg or ntype, urgent=True, sid=sid,
                   state=state.get("status"))
    if event in INBOX_ACTED:
        # Preserve the answer across dashboard scans that both see the next prompt's state.
        state["notification_epoch"] = state["ts"]
        try:
            inbox_clear_session(sid, keep_pr=event == "SessionEnd")
        except OSError:
            pass
    save_json(path, state)
    close_requests(sid, event, data)
    if event == "PermissionRequest":
        decision = wait_for_approval(sid, data, state)
        if decision:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest",
                                                     "decision": decision}}))


# ---------------------------------------------------------------- approvals
# A PermissionRequest hook and the terminal dialog answer the same prompt in parallel: the
# dialog shows at once, the first answer wins (measured on Claude Code 2.1.321, see
# docs/plans/2026-11-09-dashboard-approvals.md). So the hook may wait for the dashboard
# without delaying the terminal; any failure here prints nothing and leaves it to the terminal.

APPROVAL_POLL = 0.3


def approvals_enabled():
    env = os.environ.get("CCDECK_APPROVALS")
    if env is not None:
        return env == "1"
    return bool(load_json(CONFIG_FILE, {}).get("approvals"))


def input_hash(tool_name, tool_input):
    blob = json.dumps([tool_name, tool_input], sort_keys=True, separators=(",", ":"), default=str)
    return hashlib.sha256(blob.encode()).hexdigest()


def pid_is_headless(pid):
    # exact arguments only: ps words split a quoted prompt, so its `--` could hide a real -p. Unreadable: interactive
    return is_print_argv(_process_argv(pid) if pid else [])


def claude_is_headless():
    return pid_is_headless(find_claude_ancestor())


def ensure_req_dir():
    REQ_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(DATA_DIR, 0o700)
        os.chmod(REQ_DIR, 0o700)
    except OSError:
        pass


def write_private(path, data):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def open_requests(sid=None):
    out = []
    if not REQ_DIR.is_dir():
        return out
    for p in REQ_DIR.glob("*.json"):
        if p.name.endswith(".answer.json"):
            continue
        r = load_json(p, None)
        if not isinstance(r, dict) or not r.get("id"):
            continue
        if (REQ_DIR / f"{r['id']}.over").exists():
            continue
        if sid is None or r.get("session_id") == sid:
            out.append(r)
    out.sort(key=lambda r: r.get("created", 0))
    return out


def mark_over(req_id, why):
    try:
        (REQ_DIR / f"{req_id}.over").write_text(why)
    except OSError:
        pass


def close_requests(sid, event, data):
    """Other hook events of the session tell us a pending prompt was answered elsewhere."""
    if event in ("PermissionRequest", "Notification", "SessionStart"):
        return
    reqs = open_requests(sid)
    if not reqs:
        return
    if event in ("PostToolUse", "PostToolUseFailure"):
        tool = data.get("tool_name")
        h = input_hash(tool, data.get("tool_input"))
        exact = [r for r in reqs if r.get("input_hash") == h]
        # Fallback when the tool input was normalised: the oldest request for that tool.
        hits = exact or [r for r in reqs if r.get("tool_name") == tool][:1]
        for r in hits:
            mark_over(r["id"], f"{event} (answered in the terminal or by a rule)")
    else:  # UserPromptSubmit, Stop, SessionEnd, PermissionDenied
        for r in reqs:
            mark_over(r["id"], event)


def cleanup_request(req_id):
    for suffix in (".json", ".answer.json", ".over"):
        try:
            (REQ_DIR / f"{req_id}{suffix}").unlink()
        except OSError:
            pass


def valid_decision(answer, req):
    if not isinstance(answer, dict) or answer.get("id") != req["id"]:
        return None
    if answer.get("input_hash") != req["input_hash"]:
        return None
    d = answer.get("decision")
    if not isinstance(d, dict):
        return None
    if d.get("behavior") == "allow":
        return {"behavior": "allow"}
    if d.get("behavior") == "deny":
        out = {"behavior": "deny"}
        if isinstance(d.get("message"), str) and d["message"].strip():
            out["message"] = d["message"].strip()[:2000]
        if d.get("interrupt") is True:
            out["interrupt"] = True
        return out
    return None


def wait_for_approval(sid, data, state):
    """Publish the request and wait for the dashboard's answer. Returns a decision or None."""
    try:
        if not approvals_enabled() or not daemon_running() or claude_is_headless():
            return None
        tool = str(data.get("tool_name") or "")
        h = input_hash(tool, data.get("tool_input"))
        if any(r.get("input_hash") == h and time.time() - r.get("created", 0) < 2
               for r in open_requests(sid)):
            return None  # the same prompt from a second copy of the hooks
        ensure_req_dir()
        req = {
            "id": secrets.token_hex(8), "session_id": sid, "cwd": data.get("cwd"),
            "tool_name": tool, "tool_input": data.get("tool_input"),
            "permission_suggestions": data.get("permission_suggestions"),
            "permission_mode": data.get("permission_mode"),
            "mcp_server": data.get("mcp_server"), "input_hash": h,
            "created": time.time(), "pid": os.getpid(),
        }
        write_private(REQ_DIR / f"{req['id']}.json", req)
    except Exception:
        return None
    wait = float(os.environ.get("CCDECK_APPROVAL_WAIT", HOOK_TIMEOUTS["PermissionRequest"] - 60))
    deadline = time.time() + wait
    last_daemon_ok = time.time()
    try:
        while time.time() < deadline:
            answer = load_json(REQ_DIR / f"{req['id']}.answer.json", None)
            if answer is not None:
                return valid_decision(answer, req)
            if (REQ_DIR / f"{req['id']}.over").exists():
                return None
            if daemon_running():
                last_daemon_ok = time.time()
            elif time.time() - last_daemon_ok > 30:
                return None
            time.sleep(APPROVAL_POLL)
        return None
    except Exception:
        return None
    finally:
        cleanup_request(req["id"])


def settings_view():
    """The settings the dashboard's settings panel shows: each one's value, and the environment
    variable that overrides it in the server's environment, if one does."""
    env = os.environ.get
    return {
        "review_requests": {"value": review_scope(),
                            "locked": "CCDECK_REVIEW_REQUESTS=0" if env("CCDECK_REVIEW_REQUESTS") == "0" else None},
        "approvals": {"value": approvals_enabled(),
                      "locked": f"CCDECK_APPROVALS={env('CCDECK_APPROVALS')}" if env("CCDECK_APPROVALS") is not None else None},
        "notifications": {c: {"value": notify_enabled(c),
                              "locked": "CCDECK_NOTIFY=0" if env("CCDECK_NOTIFY") == "0" else None}
                          for c in NOTIFY_CHANNELS},
    }


def set_setting(key, value):
    """Save one setting to config.json. key is review_requests, approvals or notifications.<channel>.
    Raises ValueError for an unknown key or a value it can't take.
    The dashboard (a thread per request) and the ccdeck commands (other processes) all write config.json,
    each reading the whole file and saving it back, so a file lock keeps one from undoing another's change."""
    import fcntl
    if not (key == "review_requests" and isinstance(value, str) and value in REVIEW_SCOPES
            or key == "approvals" and isinstance(value, bool)
            or key.startswith("notifications.") and key.split(".", 1)[1] in NOTIFY_CHANNELS and isinstance(value, bool)):
        raise ValueError(f"can't set {key} to {value!r}")
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    with open(DATA_DIR / "config.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # released when the file closes
        cfg = load_json(CONFIG_FILE, {})
        cfg = cfg if isinstance(cfg, dict) else {}
        if key.startswith("notifications."):
            cfg["notifications"] = {**notify_settings(cfg), key.split(".", 1)[1]: value}
        else:
            cfg[key] = value
        save_json(CONFIG_FILE, cfg)


def cmd_approvals(args):
