                  "XDG_RUNTIME_DIR", "XDG_CURRENT_DESKTOP")


PREVIEW_ENV = ("CLAUDE_CONFIG_DIR", "CCDECK_PREVIEW", "CCDECK_NOTIFY", "CCDECK_AUTOSTART")  # what a preview overrides


def user_env(env):
    """env as you had it before `ccdeck preview` overrode it, for what a preview starts on your behalf (claude
    --resume): its config folder has no settings or hooks, and CCDECK_NOTIFY=0 would silence that session."""
    saved = env.pop("CCDECK_PREVIEW_SAVED_ENV", None)
    try:
        orig = json.loads(saved) if saved else {}
    except ValueError:
        orig = {}
    for k, v in (orig.items() if isinstance(orig, dict) else ()):
        if k in PREVIEW_ENV:
            if isinstance(v, str):
                env[k] = v
            else:
                env.pop(k, None)
    return env


def desktop_env():
    """Environment with the graphical session's variables (a systemd service may start before them)."""
    env = dict(os.environ)
    if IS_MAC or env.get("DISPLAY") or env.get("WAYLAND_DISPLAY"):
        return env
    try:
        out = subprocess.run(["systemctl", "--user", "show-environment"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return env
    for line in out.splitlines():
        k, _, v = line.partition("=")
        if k in GRAPHICAL_VARS and k not in env:
            env[k] = v
    return env


def applescript_str(text):
    return '"' + str(text).replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ") + '"'


NOTIFY_CHANNELS = ("desktop",)  # one switch per channel in config.json; terminal, app and web go here later


def notify_settings(cfg):
    """config.json's notifications map; anything else there (null, a list, …) counts as empty."""
    v = cfg.get("notifications") if isinstance(cfg, dict) else None
    return v if isinstance(v, dict) else {}


def notify_enabled(channel):
    """CCDECK_NOTIFY=0 turns every channel off; otherwise config.json's notifications.<channel> (default on)."""
    if os.environ.get("CCDECK_NOTIFY", "1") == "0":
        return False
    return notify_settings(load_json(CONFIG_FILE, {})).get(channel, True) is not False


def inbox_add(sid, state, title, body):
    """Keep a notification until it's acted on. One file each, so the dashboard, hooks and click helpers
    never overwrite each other's changes."""
    INBOX_DIR.mkdir(parents=True, exist_ok=True)
    with open(INBOX_DIR / ".lock", "w") as lock:
        # two hooks for one session at once must still leave one entry; but a hook must finish fast, so give
        # up after a second (BlockingIOError: the notification still goes out, without a bell entry)
        deadline = time.monotonic() + 1
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise
                time.sleep(0.02)
        for d in inbox_items():
            if d["sid"] == sid:
                inbox_clear(d["id"])  # one per session: the newest says what it needs now
        nid = f"{int(time.time() * 1000)}-{secrets.token_hex(3)}"
        save_json(INBOX_DIR / f"{nid}.json", {"id": nid, "sid": sid, "state": state, "title": title, "body": body, "ts": time.time()})
    return nid


def inbox_items():
    items = []
    for f in INBOX_DIR.glob("*.json"):
        d = load_json(f, {})
        if d.get("id") == f.stem and isinstance(d.get("sid"), str):
            items.append(d)
    return sorted(items, key=lambda d: d.get("ts") or 0, reverse=True)


def inbox_clear(nid):
    if isinstance(nid, str) and re.fullmatch(r"[\w-]+", nid):
        (INBOX_DIR / f"{nid}.json").unlink(missing_ok=True)


def inbox_clear_session(sid, keep_pr=False):
    for d in inbox_items():
        if d["sid"] == sid and not (keep_pr and d.get("state") in PR_STATES):
            inbox_clear(d["id"])


def prompt_identity(r):
    """Which prompt a session waits on, so two in a row in one state each get a notification. A question or
    plan is its tool call, from the transcript. A permission prompt is the hook's epoch (it moves when a prompt
    is answered): the hook can report it before the transcript has the tool call. Any other state (a PR's) has
    none: it changes only with the state, or closing the session would bring back one you dismissed."""
    if r["state"] in ("question", "plan"):
        return r.get("pending_id")
    if r["state"] == "permission":
        return r.get("notification_epoch")
    return None


def inbox_sweep(rows):
    """Drop notifications that were acted on: the session left the state that raised it (you sent a
    message, answered the permission prompt, the session closed), or the session is gone. A closed session
    keeps the state of a question it never answered, so closing has to count on its own; a PR's state is
    about the PR, though, and stays news after the session closes."""
    cur = {r["id"]: r["state"] for r in rows}
    closed = {r["id"] for r in rows if not r.get("alive", True)}
    for d in inbox_items():
        if cur.get(d["sid"]) != d.get("state") or (d["sid"] in closed and d.get("state") not in PR_STATES):
            inbox_clear(d["id"])


def notify(title, body, urgent=False, sid=None, state=None, text=None):
    """body: the short line for the desktop popup; text: the whole message, kept in the inbox."""
    try:
        nid = inbox_add(sid, state, title, text or body) if sid else None
    except OSError:  # an unwritable inbox loses the bell entry, not the desktop notification (or the hook)
        nid = None
    if not notify_enabled("desktop"):
        return
    if IS_MAC and (tn := shutil.which("terminal-notifier")):
        # clickable: on click, terminal-notifier runs `ccdeck focus <sid>`, which goes to the session's tab.
        # osascript's notifications belong to Script Editor, so clicking one only opens Script Editor
        cmd = [tn, "-title", title[:120], "-message", body[:200] or " ", "-group", "ccdeck-" + (sid or "ccdeck")]
        if urgent:
            cmd += ["-sound", "Glass"]
        if sid:
            cmd += ["-execute", shlex.join([sys.executable, str(Path(__file__).resolve()), "focus", sid])]
        try:
            # it exits once the notification is delivered (a click relaunches it); not 0 means it wasn't,
            # e.g. 3 when notifications aren't allowed for it: send it the old way rather than lose it.
            # A timeout kills it, so that falls back too
            if subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2).returncode == 0:  # hooks have ~5 s
                return
        except (OSError, subprocess.SubprocessError):
            pass
    if IS_MAC:
        script = f"display notification {applescript_str(body[:200])} with title {applescript_str(title[:120])}"
        if urgent:
            script += ' sound name "Glass"'
        try:
            subprocess.Popen(["osascript", "-e", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
        return
    if sid and importlib.util.find_spec("gi"):
        # a detached helper sends it and waits for a click, which goes to the session's tab
        cmd = ([sys.executable, str(Path(__file__).resolve()), "notify-click", sid] + (["--id", nid] if nid else [])
               + (["--urgent"] if urgent else []) + ["--", title, body])
    elif shutil.which("notify-send"):
        cmd = ["notify-send", "-a", "Claude Code", "-i", "utilities-terminal"] + (["-u", "critical"] if urgent else []) + [title, body]
    else:
        return
    try:
        subprocess.Popen(cmd, env=desktop_env(), start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


NOTIFY_SETTINGS_URL = "x-apple.systempreferences:com.apple.Notifications-Settings.extension"


def terminal_notifier_app():
    """terminal-notifier's .app bundle (Homebrew's command is a script that runs the binary inside it), or None."""
    tn = shutil.which("terminal-notifier")
    if not tn:
        return None
    real = Path(os.path.realpath(tn))
    for p in (real, *real.parents):
        if p.suffix == ".app":
            return p
    if (app := real.parent.parent / "terminal-notifier.app").is_dir():
        return app
    try:
        m = re.search(r'"([^"]+\.app)/Contents/MacOS/', real.read_text(errors="replace")[:4000])
    except OSError:
        return None
    return Path(m.group(1)) if m and Path(m.group(1)).is_dir() else None


def terminal_notifier_version():
    """(major, minor) of the installed terminal-notifier ("terminal-notifier (3.1.0) is a …"), or None."""
    try:
        out = subprocess.run(["terminal-notifier", "-help"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"terminal-notifier \((\d+)\.(\d+)", out.stdout + out.stderr)
    return (int(m.group(1)), int(m.group(2))) if m else None


def terminal_notifier_authorization():
    """What macOS allows terminal-notifier: "authorized", "denied", "not requested yet", …; None if unknown."""
    try:
        out = subprocess.run(["terminal-notifier", "-diagnose"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"^\s*authorization\s+(.+?)\s*$", out, re.M)
    return m.group(1) if m else None


def setup_notifications(interactive):
    """Make notifications clickable: on macOS, install terminal-notifier and get macOS to allow it."""
    if not IS_MAC:
        if importlib.util.find_spec("gi"):
            print("Notifications are clickable: a click goes to the session's terminal tab.")
        else:
            print("To make notifications clickable, install PyGObject (sudo apt install python3-gi).")
        return
    if not shutil.which("terminal-notifier"):
        hint = "brew install terminal-notifier, then ccdeck notifications setup"
        if not (interactive and shutil.which("brew")):
            print(f"  Tip: to make notifications clickable (a click goes to the session's tab): {hint}.")
            return
        if input("Install terminal-notifier with Homebrew, so clicking a notification goes to its session's tab? [Y/n] ").strip().lower() not in ("", "y", "yes"):
            print(f"Skipped. Later: {hint}.")
            return
        if subprocess.run(["brew", "install", "terminal-notifier"]).returncode != 0 or not shutil.which("terminal-notifier"):
            print(f"Homebrew couldn't install it. Try: {hint}.")
            return
    ver = terminal_notifier_version()
    if ver and ver < (3, 0):  # 2.x can't say whether macOS allows it (-diagnose) or be opened to ask
        upgrade = "brew upgrade terminal-notifier, then ccdeck notifications setup"
        if not (interactive and shutil.which("brew")) or input(
                f"terminal-notifier {ver[0]}.{ver[1]} is too old; upgrade it to 3.x with Homebrew? [Y/n] ").strip().lower() not in ("", "y", "yes"):
            print(f"Clickable notifications need terminal-notifier 3.x (this is {ver[0]}.{ver[1]}): {upgrade}.")
            return
        if subprocess.run(["brew", "upgrade", "terminal-notifier"]).returncode != 0 or (terminal_notifier_version() or (0,)) < (3, 0):
            print(f"Homebrew couldn't upgrade it. Try: {upgrade}.")
            return
    auth = terminal_notifier_authorization()
    if auth == "not requested yet" and (app := terminal_notifier_app()):
        # started from a shell it can't ask for permission (it exits with 3); opened as an app, macOS asks
        print("macOS will ask whether terminal-notifier may send notifications: choose Allow.")
        try:
            subprocess.run(["open", "-W", "-a", str(app), "--args", "-title", "ccdeck",
                            "-message", "Notifications from ccdeck are on. Clicking one goes to its session's tab."],
                           timeout=60, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError):
            pass
        for _ in range(30 if interactive else 0):  # give the prompt a moment to be answered
            if (auth := terminal_notifier_authorization()) == "authorized":
                break
            time.sleep(1)
        else:
            auth = terminal_notifier_authorization()
    if auth == "authorized":
        print("Notifications are clickable: a click goes to the session's Terminal or iTerm tab.")
        print("  The first click may ask whether terminal-notifier can control Terminal: choose OK.")
        return
    print("macOS doesn't allow terminal-notifier's notifications yet. In System Settings > Notifications >")
    print("terminal-notifier, turn on Allow notifications (style: Banners). Until then they come from osascript,")
    print("and clicking one opens Script Editor. Check with: ccdeck notifications setup")
    if interactive:
        open_path(NOTIFY_SETTINGS_URL)


TERMINALS = [  # (binary, args before the command)
    ("gnome-terminal", ["--"]),
    ("ptyxis", ["--new-window", "--"]),
    ("kgx", ["-e"]),
    ("konsole", ["-e"]),
    ("xfce4-terminal", ["-x"]),
    ("tilix", ["-e"]),
    ("kitty", []),
    ("alacritty", ["-e"]),
    ("x-terminal-emulator", ["-e"]),
    ("xterm", ["-e"]),
]


def mac_terminal_app_of(pid):
    """"terminal" or "iterm": the macOS terminal app a process runs in (its nearest such ancestor), or None."""
    for _ in range(12):
        if not pid or pid <= 1:
            return None
        # the program, not its arguments (a prompt can name iTerm.app); exact, as a path can have a space in it
        exe = (_process_argv(pid) or proc_cmdline(pid) or [""])[0]
        if "/Terminal.app/" in exe:
            return "terminal"
        if "/iTerm.app/" in exe or "/iTerm2.app/" in exe:
            return "iterm"
        pid = proc_ppid(pid)
    return None


def mac_terminal_used():
    """The terminal you use, when both are installed: the one most of your open sessions run in, else the
    one the dashboard was started from (a session's hook starts it), else None."""
    try:
        # one vote per session: the first of its processes that runs in a terminal (it can also be open in an IDE)
        apps = [a for peer in peer_sessions().values()
                if (a := next(filter(None, map(mac_terminal_app_of, peer.get("pids") or [peer.get("pid")])), None))]
    except Exception:  # finding out is a nicety: never fail opening a terminal over it
        apps = []
    if apps:
        return max(("terminal", "iterm"), key=apps.count)  # a tie goes to Terminal
    return {"Apple_Terminal": "terminal", "iTerm.app": "iterm"}.get(os.environ.get("TERM_PROGRAM", ""))


def mac_terminal_command(cwd, argv, app=None):
    """osascript that opens Terminal or iTerm and runs the command in a new window."""
    line = applescript_str(f"cd {shlex.quote(cwd)} && {shlex.join(argv)}")
    if app is None:
        has_iterm = Path("/Applications/iTerm.app").exists() or (HOME / "Applications" / "iTerm.app").exists()
        app = (mac_terminal_used() or "iterm") if has_iterm else "terminal"
    if app == "iterm":
        return ["osascript", "-e", 'tell application "iTerm"', "-e", "activate",
                "-e", "set w to (create window with default profile)",
                "-e", f"tell current session of w to write text {line}", "-e", "end tell"]
    return ["osascript", "-e", f'tell application "Terminal" to do script {line}',
            "-e", 'tell application "Terminal" to activate']


def terminal_command(cwd, argv):
    custom = os.environ.get("CCDECK_TERMINAL")
    if IS_MAC and (not custom or custom.strip().lower() in ("iterm", "terminal")):
        return mac_terminal_command(cwd, argv, custom.strip().lower() if custom else None)
    script = f"cd {shlex.quote(cwd)} && {shlex.join(argv)}; exec \"${{SHELL:-bash}}\""
    inner = ["bash", "-lc", script]
    candidates = [(shlex.split(custom)[0], shlex.split(custom)[1:])] if custom else TERMINALS
    for binary, pre in candidates:
        if shutil.which(binary):
            return [binary] + pre + inner
    return None


def open_terminal(cwd, argv):
    """Open a new terminal window running argv in cwd; leaves a shell open afterwards."""
    cmd = terminal_command(cwd, argv)
    if not cmd:
        raise RuntimeError("No terminal emulator found; set CCDECK_TERMINAL")
    subprocess.Popen(cmd, cwd=cwd if os.path.isdir(cwd) else None, env=user_env(desktop_env()),
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if cmd[0] == "osascript":
        return "iTerm" if 'tell application "iTerm"' in cmd else "Terminal"
    return cmd[0]


def proc_environ(pid):
    try:
        with open(f"/proc/{int(pid)}/environ", "rb") as f:
            return dict(kv.split("=", 1) for kv in f.read().decode(errors="replace").split("\0") if "=" in kv)
    except (OSError, ValueError, TypeError):
        return {}


def proc_tty(pid):
    try:
        tty = subprocess.run(["ps", "-o", "tty=", "-p", str(int(pid))], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        return None
    return "/dev/" + tty if tty and tty not in ("?", "??") else None


def gnome_terminal_window():
    """(D-Bus path, active tab index) of any open gnome-terminal window, or None."""
    def gdbus(*args):
        return subprocess.run(["gdbus", *args], capture_output=True, text=True, timeout=5, env=desktop_env()).stdout
    try:
        m = re.search(r"node (\d+)", gdbus("introspect", "--session", "-d", "org.gnome.Terminal", "-o", "/org/gnome/Terminal/window"))
        if not m:
            return None
        path = f"/org/gnome/Terminal/window/{m.group(1)}"
        tab = re.search(r"<(-?\d+)>", gdbus("call", "--session", "-d", "org.gnome.Terminal", "-o", path,
                                            "-m", "org.gtk.Actions.Describe", "active-tab"))
    except (OSError, subprocess.SubprocessError):
        return None
    return (path, int(tab.group(1))) if tab else None


def focus_commands(env, tty, token=None):
    """[(label, [commands...])] that bring the terminal tab of a process to the front, best first.
    token: a Wayland activation token (from a notification click), which lets GNOME raise the window."""
    out = []
    pane = env.get("TMUX_PANE")
    if pane:
        if not shutil.which("tmux"):
            return out  # GNOME_TERMINAL_SCREEN would name the tab that started the tmux server, not this pane's
        sock = (env.get("TMUX") or "").split(",")[0]
        tmux = ["tmux"] + (["-S", sock] if sock else [])
        # shortcut: picks the window and pane, but doesn't raise the terminal the tmux client runs in
        # first command: how many clients show the pane's session; 0 (detached) means nobody would see it
        out.append(("tmux", [tmux + ["display-message", "-p", "-t", pane, "#{session_attached}"],
                             tmux + ["select-window", "-t", pane], tmux + ["select-pane", "-t", pane]]))
        return out  # inside tmux, GNOME_TERMINAL_SCREEN is the tmux server's, not this pane's
    m = re.fullmatch(r"/org/gnome/Terminal/screen/([0-9a-f_]{36})", env.get("GNOME_TERMINAL_SCREEN") or "")
    if m and shutil.which("gdbus"):
        # gnome-terminal's GNOME Shell search provider: activating a result switches to that tab, Wayland included
        cmds = []
        win = token and re.fullmatch(r"[\w/.:+=-]+", token) and gnome_terminal_window()
        if win:
            # without the token GNOME says "Terminal is ready" instead of raising the window. A window action
            # carrying it hands it to gnome-terminal for the present that follows; setting active-tab to the tab
            # already active changes nothing (find-clear, used before, cleared that tab's search)
            path, tab = win
            cmds.append(["gdbus", "call", "--session", "-d", "org.gnome.Terminal", "-o", path, "-m", "org.gtk.Actions.SetState",
                         "--", "active-tab", f"<{tab}>", f"{{'desktop-startup-id': <'{token}'>, 'activation-token': <'{token}'>}}"])
        out.append(("gnome-terminal", cmds + [["gdbus", "call", "--session", "-d", "org.gnome.Terminal",
                                        "-o", "/org/gnome/Terminal/SearchProvider",
                                        "-m", "org.gnome.Shell.SearchProvider2.ActivateResult",
                                        m.group(1).replace("_", "-"), "[]", "0"]]))
    if IS_MAC and tty:
        t = applescript_str(tty)
        out.append(("iTerm", [["osascript", "-e", 'if application "iTerm" is not running then return "no"',
                               "-e", 'tell application "iTerm"', "-e", "repeat with w in windows",
                               "-e", "repeat with t in tabs of w", "-e", "repeat with s in sessions of t",
                               "-e", f"if tty of s is {t} then",
                               "-e", "select w", "-e", "select t", "-e", "select s", "-e", "activate",
                               "-e", 'return "ok"', "-e", "end if",
                               "-e", "end repeat", "-e", "end repeat", "-e", "end repeat", "-e", "end tell",
                               "-e", 'return "no"']]))
        out.append(("Terminal", [["osascript", "-e", 'if application "Terminal" is not running then return "no"',
                                  "-e", 'tell application "Terminal"', "-e", "repeat with w in windows",
                                  "-e", "repeat with t in tabs of w", "-e", f"if tty of t is {t} then",
                                  "-e", "set selected of t to true", "-e", "set index of w to 1", "-e", "activate",
                                  "-e", 'return "ok"', "-e", "end if",
                                  "-e", "end repeat", "-e", "end repeat", "-e", "end tell", "-e", 'return "no"']]))
    return out


def tmux_pane_of_tty(tty):
    """The tmux pane (%N) whose terminal is tty, on the default tmux server; None if there's none."""
    # shortcut: default socket only; without /proc we can't read the process's TMUX to find another server
    if not tty or not shutil.which("tmux"):
        return None
    try:
        out = subprocess.run(["tmux", "list-panes", "-a", "-F", "#{pane_tty} #{pane_id}"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return next((pane for t, _, pane in (line.partition(" ") for line in out.splitlines()) if t == tty), None)


def focus_terminal(pid, token=None):
    """Switch to the terminal tab running pid. Returns the terminal's name, or None if we can't."""
    env = proc_environ(pid) if USE_PROC else {}
    tty = proc_tty(pid) if (IS_MAC or not USE_PROC) else None
    if not USE_PROC and (pane := tmux_pane_of_tty(tty)):
        env = {"TMUX_PANE": pane}  # no /proc to read TMUX_PANE from: the pane that owns the tty
    for label, cmds in focus_commands(env, tty if IS_MAC else None, token):
        try:
            rs = [subprocess.run(c, capture_output=True, text=True, timeout=10, env=desktop_env()) for c in cmds]
        except (OSError, subprocess.SubprocessError):
            continue
        if label == "tmux" and rs[0].stdout.strip() in ("", "0"):
            continue  # detached session: switching succeeds but shows nothing
        if all(r.returncode == 0 for r in rs) and (cmds[0][0] != "osascript" or rs[0].stdout.strip() == "ok"):
            return label
    return None


def notification_click(title, body, urgent, wanted=lambda: True):
    """Show a desktop notification with a default action. Returns (clicked, activation token or None).
    wanted() is polled; once it's False (acted on elsewhere) the notification is withdrawn.
    GNOME sends the click only to the connection that sent the notification (so not `gdbus monitor`),
    and its proxy makes notify-send drop actions, so this holds one connection through PyGObject.
    The token is what lets the terminal raise its window on Wayland."""
    from gi.repository import Gio, GLib  # optional; notify() checks it's there
    bus, loop, state = Gio.bus_get_sync(Gio.BusType.SESSION), GLib.MainLoop(), {"id": None, "clicked": False, "token": None}

    def on_signal(_conn, _sender, _path, _iface, name, params):
        nid, *rest = params.unpack()
        # a click sends ActivationToken, ActionInvoked and NotificationClosed, often in one batch,
        # so Closed may still arrive after quit(): it ends the wait but never undoes a click
        if nid != state["id"]:
            return
        if name == "ActivationToken":
            state["token"] = rest[0]
        elif name == "ActionInvoked" and rest == ["default"]:
            state["clicked"] = True
            loop.quit()
        elif name == "NotificationClosed":
            loop.quit()

    bus.signal_subscribe("org.freedesktop.Notifications", "org.freedesktop.Notifications", None,
                         "/org/freedesktop/Notifications", None, Gio.DBusSignalFlags.NONE, on_signal)
    hints = {"urgency": GLib.Variant("y", 2 if urgent else 1)}
    state["id"] = bus.call_sync(
        "org.freedesktop.Notifications", "/org/freedesktop/Notifications", "org.freedesktop.Notifications", "Notify",
        GLib.Variant("(susssasa{sv}i)", ("Claude Code", 0, "utilities-terminal", title[:120], body[:300],
                                         ["default", "Go to tab"], hints, -1)),
        None, Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
    def poll():
        if wanted():
            return True
        bus.call_sync("org.freedesktop.Notifications", "/org/freedesktop/Notifications", "org.freedesktop.Notifications",
                      "CloseNotification", GLib.Variant("(u)", (state["id"],)), None, Gio.DBusCallFlags.NONE, -1, None)
        loop.quit()
        return False

    GLib.timeout_add_seconds(2, poll)
    GLib.timeout_add_seconds(4 * 3600, loop.quit)  # shortcut: a notification left in the tray stops being clickable after 4h
    loop.run()
    return state["clicked"], state["token"]


def cmd_notify_click(args):
    """Detached helper: show the notification and, if it's clicked, go to the session's terminal tab."""
    try:
        entry = INBOX_DIR / f"{args.id}.json" if args.id else None
        clicked, token = notification_click(args.title, args.body, args.urgent,
                                            (lambda: entry.exists()) if entry else (lambda: True))
    except Exception as e:  # GLib.Error, no session bus, …: the notification is lost, say why
        print(f"ccdeck notify-click: {e}", file=sys.stderr)
        return
    if clicked:
        try:
            inbox_clear(args.id)  # clicking it is acting on it
        except OSError:
            pass  # still go to the tab
    if clicked and (peer := peer_sessions().get(args.sid)):
        focus_terminal(peer["pid"], token)


def cmd_focus(args):
    """Go to the terminal tab of an open session (what a clicked macOS notification runs)."""
    try:
        inbox_clear_session(args.sid)  # clicking the notification is acting on it
    except OSError:
        pass
    peer = peer_sessions().get(args.sid)
    if not peer:
        sys.exit("That session isn't open in a terminal.")
    label = focus_terminal(peer["pid"])
    if not label:
        sys.exit("Couldn't switch to its tab (supported: Terminal, iTerm, gnome-terminal, tmux).")
    print(f"Switched to its {label} tab.")


def open_path(target):
    opener = "open" if IS_MAC else "xdg-open"
    if shutil.which(opener):
        subprocess.Popen([opener, target], env=desktop_env(), stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


