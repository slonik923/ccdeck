def cmd_notifications(args):
    words = args.words
    if words == ["setup"]:
        return setup_notifications(sys.stdin.isatty())
    if words and words[-1] not in ("on", "off"):
        sys.exit("usage: ccdeck notifications [CHANNEL] [on|off] | setup")
    if words:
        channels = words[:-1] or list(NOTIFY_CHANNELS)
        if any(c not in NOTIFY_CHANNELS for c in channels):
            sys.exit(f"Unknown channel; channels: {', '.join(NOTIFY_CHANNELS)}")
        for c in channels:
            set_setting("notifications." + c, words[-1] == "on")
    for c in NOTIFY_CHANNELS:
        print(f"{c} notifications: {'on' if notify_enabled(c) else 'off'}")
    if os.environ.get("CCDECK_NOTIFY") == "0":
        print("(CCDECK_NOTIFY=0 turns them all off, whatever the setting)")


def autostart_daemon(force=False):
    """Start the dashboard in the background if nothing serves it (plugin installs have no service).

    force: asked for explicitly (`ccdeck open`), so CCDECK_AUTOSTART and the retry pause don't apply."""
    if daemon_running():
        return
    if not force and (os.environ.get("CCDECK_AUTOSTART", "1") == "0" or service_installed()):
        return
    import fcntl
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    try:
        lock = open(DATA_DIR / "autostart.lock", "a+")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another hook is starting it right now
    with lock:
        lock.seek(0)
        last = lock.read().strip()
        if not force and last.replace(".", "", 1).isdigit() and time.time() - float(last) < 30:
            return
        lock.seek(0)
        lock.truncate()
        lock.write(str(time.time()))
        lock.flush()
        log = open(DATA_DIR / "serve.log", "ab")
        script = STABLE_DIR / "ccdeck" if running_from_plugin() and (STABLE_DIR / "ccdeck").exists() else SCRIPT
        subprocess.Popen([sys.executable, str(script), "serve", "--port", str(DEFAULT_PORT)],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
                         close_fds=True)


