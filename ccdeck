def cmd_resume(args):
    s = resolve(args.id)
    peers = peer_sessions()
    peer = peers.get(s["id"])
    # a `claude -p` run on it doesn't make it open: only interactive processes are tabs to go to
    pids = [p for p in (peer.get("pids") or [peer["pid"]]) if not pid_is_headless(p)] if peer else []
    if not pids:
        peer = None
    if not peer and not args.extra:
        registered = {pid for entry in peers.values() for pid in entry.get("pids", [entry["pid"]])}
        pids = [p[0] for p in running_claude_processes() if p[0] not in registered and s["id"] in resumed_ids([p])]
        hook = load_states().get(s["id"]) or {}
        pid = hook.get("pid")
        if (pid and pid not in registered and pid not in pids and not hook.get("headless")
                and hook.get("status") != "ended" and hook.get("pid_start") is not None
                and pid_alive(pid, hook["pid_start"])):
            pids.append(pid)

    if pids and not args.extra:
        # already open: a second `claude --resume` would fork it, so go to its tab, like the dashboard does
        label = next((label for pid in pids if (label := focus_terminal(pid))), None)
        if label:
            print(f"Switched to its {label} tab (@{(peer or {}).get('name') or s['id'][:8]}).")
            return
        sys.exit(f"Already open (@{(peer or {}).get('name') or s['id'][:8]}) in a terminal ccdeck can't switch to.")
    claude = shutil.which("claude")
    if not claude:
        sys.exit("`claude` is not on PATH.")
    if s["cwd"] and os.path.isdir(s["cwd"]):
        os.chdir(s["cwd"])
    if s["mark"].get("done") or s["mark"].get("parked"):
        set_mark(s["id"], done=None, done_at=None, parked=None, parked_at=None)
    print(dim(f"cd {short_path(os.getcwd())} && claude --resume {s['id']}"))
    os.execv(claude, [claude, "--resume", s["id"]] + args.extra)


