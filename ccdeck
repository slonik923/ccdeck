USE_PROC = os.path.exists("/proc/self/stat") and os.environ.get("CCDECK_NO_PROC") != "1"  # set to test the macOS path
_ps_cache = {"t": 0.0, "rows": {}, "timeout": 10}  # a hook lowers the timeout: it must exit fast


def parse_ps(text):
    """`ps -axww -o pid=,ppid=,lstart=,command=` output -> {pid: (ppid, start, command)}.

    lstart is five words in the C locale ("Thu Nov 12 17:31:28 2026"); it is the process's
    start time, used like /proc's start ticks to tell a live pid from a reused one."""
    rows = {}
    for line in text.splitlines():
        parts = line.split(None, 7)
        if len(parts) < 7 or not parts[0].isdigit() or not parts[1].isdigit():
            continue
        rows[int(parts[0])] = (int(parts[1]), " ".join(parts[2:7]), parts[7] if len(parts) > 7 else "")
    return rows


def ps_table():
    now = time.time()
    if now - _ps_cache["t"] < 1.0:
        return _ps_cache["rows"]
    try:
        out = subprocess.run(["ps", "-axww", "-o", "pid=,ppid=,lstart=,command="], capture_output=True,
                             text=True, timeout=_ps_cache["timeout"], env=dict(os.environ, LC_ALL="C")).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    _ps_cache.update(t=time.time(), rows=parse_ps(out))  # stamped after: a timed-out call isn't repeated at once
    return _ps_cache["rows"]


def _ps_row(pid):
    try:
        return ps_table().get(int(pid))
    except (ValueError, TypeError):
        return None


def _stat_fields(pid):
    with open(f"/proc/{int(pid)}/stat") as f:
        return f.read().rsplit(")", 1)[1].split()


def proc_start_time(pid):
    if not USE_PROC:
        row = _ps_row(pid)
        return row[1] if row else None
    try:
        return _stat_fields(pid)[19]
    except (OSError, IndexError, ValueError, TypeError):
        return None


def proc_ppid(pid):
    if not USE_PROC:
        row = _ps_row(pid)
        return row[0] if row else None
    try:
        return int(_stat_fields(pid)[1])
    except (OSError, IndexError, ValueError, TypeError):
        return None


def proc_cmdline(pid):
    if not USE_PROC:
        row = _ps_row(pid)
        return row[2].split() if row else []
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except (OSError, ValueError, TypeError):
        return []


def is_claude_cmd(argv):
    if not argv:
        return False
    exe = os.path.basename(argv[0])
    if exe == "claude" or "/claude/versions/" in argv[0]:  # native installer keeps versions there
        return True
    return exe.startswith("node") and any(
        "claude-code" in a or a.endswith("/claude") for a in argv[1:])


def find_claude_ancestor():
    pid = os.getppid()
    for _ in range(8):
        if not pid or pid <= 1:
            return None
        if is_claude_cmd(proc_cmdline(pid)):
            return pid
        pid = proc_ppid(pid)
    return None


_DAYS, _MONTHS = "Mon Tue Wed Thu Fri Sat Sun".split(), "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split()


def lstart_local(utc_lstart):
    """A UTC lstart ("Thu Nov 12 08:23:03 2026", the form Claude Code's registry (procStart) uses on macOS) as
    the same moment in local time, the form `ps` prints ("Thu Nov 12 09:23:03 2026"). None if it doesn't parse.
    UTC to local, not local to UTC: in the hour repeated when clocks go back, one local time is two moments."""
    import calendar
    try:
        _, mon, day, hms, year = utc_lstart.split()
        h, mi, s = (int(x) for x in hms.split(":"))
        t = time.localtime(calendar.timegm((int(year), _MONTHS.index(mon) + 1, int(day), h, mi, s, 0, 0, 0)))
    except (ValueError, OverflowError, AttributeError):
        return None
    return f"{_DAYS[t.tm_wday]} {_MONTHS[t.tm_mon - 1]} {t.tm_mday} {t.tm_hour:02}:{t.tm_min:02}:{t.tm_sec:02} {t.tm_year}"


def pid_alive(pid, start, utc=False):
    """pid runs and is the process that started at start (None: any). Without /proc, start is a `ps` lstart
    in local time, as ccdeck saves it; utc: in UTC, as Claude Code's registry (procStart) saves it. Only that
    one is converted: read as UTC, a local time would also match a process started one UTC offset later."""
    st = proc_start_time(pid) if pid else None
    if st is None or start is None:
        return st is not None
    if USE_PROC or not isinstance(start, str):
        return st == start  # /proc start ticks: the same on both sides, no time zone
    want = lstart_local(start) if utc else start  # a UTC string equal to the local one is another moment
    return bool(want) and " ".join(st.split()) == " ".join(want.split())


def running_claude_processes():
    if not USE_PROC:
        return _running_claude_ps()
    out = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return out
    for name in entries:
        if not name.isdigit():
            continue
        argv = proc_cmdline(name)
        if not is_claude_cmd(argv):
            continue
        try:
            cwd = os.readlink(f"/proc/{name}/cwd")
        except OSError:
            cwd = None
        out.append((int(name), cwd, argv))
    return out


def _process_argv(pid):
    """Read argument boundaries; ps command text cannot distinguish flags from prompt words."""
    if sys.platform != "darwin":  # also supports CCDECK_NO_PROC on Linux
        try:
            raw = Path(f"/proc/{pid}/cmdline").read_bytes().rstrip(b"\0")
        except OSError:
            return []
        return raw.decode(errors="replace").split("\0") if raw else []  # empty: a zombie, let ps say
    import ctypes
    import struct
    try:
        libc = ctypes.CDLL(None)
        # CTL_KERN, KERN_PROCARGS2: argc, executable path, padding, then NUL-delimited argv.
        mib = (ctypes.c_int * 3)(1, 49, int(pid))
        size = ctypes.c_size_t(1024 * 1024)
        buf = ctypes.create_string_buffer(size.value)
        if libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0) != 0:
            return []
        data = buf.raw[:size.value]
        argc = struct.unpack_from("i", data)[0]
        start = data.index(b"\0", struct.calcsize("i"))
        while start < len(data) and data[start] == 0:
            start += 1
        args = data[start:].split(b"\0")
        return [a.decode(errors="replace") for a in args[:argc]] if 0 < argc <= len(args) else []
    except (OSError, ValueError, struct.error):
        return []


def _running_claude_ps():
    procs = []
    for pid, row in ps_table().items():
        words = row[2].split()
        if is_claude_cmd(words):
            # ps loses where one argument ends; when the real ones can't be read, its words still say it's open
            argv = _process_argv(pid) or words
            if is_claude_cmd(argv):
                procs.append((pid, argv))
    cwds = {}
    if procs and shutil.which("lsof"):
        try:
            out = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn", "-p", ",".join(str(p) for p, _ in procs)],
                                 capture_output=True, text=True, timeout=10).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        pid = None
        for line in out.splitlines():
            if line.startswith("p") and line[1:].isdigit():
                pid = int(line[1:])
            elif line.startswith("n") and pid is not None:
                cwds[pid] = line[1:]
    return [(pid, cwds.get(pid), argv) for pid, argv in procs]


