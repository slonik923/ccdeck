FAIL = {"FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "ERROR", "STARTUP_FAILURE"}


def summarize_checks(rollup):
    if not rollup:
        return "none"
    failing = pending = False
    for ch in rollup:
        if not isinstance(ch, dict):
            continue
        concl = (ch.get("conclusion") or "").upper()
        state = (ch.get("state") or "").upper()
        status = (ch.get("status") or "").upper()
        if concl in FAIL or state in ("FAILURE", "ERROR"):
            failing = True
        elif (status and status != "COMPLETED") or state in ("PENDING", "EXPECTED"):
            pending = True
    return "failing" if failing else "pending" if pending else "passing"


def fetch_pr(url):
    if not shutil.which("gh"):
        return {"error": "gh not installed"}
    try:
        r = subprocess.run(
            ["gh", "pr", "view", url, "--json",
             "number,title,state,isDraft,reviewDecision,mergeable,statusCheckRollup,headRefName"],
            capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as e:
        return {"error": str(e)}
    if r.returncode != 0:
        return {"error": one_line(r.stderr, 200) or "gh failed"}
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return {"error": "bad gh output"}
    return {
        "number": d.get("number"), "title": d.get("title"),
        "state": (d.get("state") or "").lower(),  # open | closed | merged
        "draft": bool(d.get("isDraft")),
        "review": (d.get("reviewDecision") or "").lower(),  # approved | changes_requested | review_required
        "mergeable": (d.get("mergeable") or "").lower(),  # mergeable | conflicting | unknown
        "checks": summarize_checks(d.get("statusCheckRollup")),
        "head": d.get("headRefName") or "",
    }


REVIEW_SCOPES = {  # config.json's review_requests: which requests the dashboard lists
    "all": "--review-requested=@me",  # asked of you, or of a team you're in
    "mine": "user-review-requested:@me",  # asked of you by name; team requests are left out
    "off": None,
}


def review_scope():
    """config.json's review_requests (default all); CCDECK_REVIEW_REQUESTS=0 turns it off whatever it says."""
    if os.environ.get("CCDECK_REVIEW_REQUESTS") == "0":
        return "off"
    cfg = load_json(CONFIG_FILE, {})
    v = cfg.get("review_requests") if isinstance(cfg, dict) else None
    return v if isinstance(v, str) and v in REVIEW_SCOPES else "all"  # a list or dict there isn't hashable


def fetch_review_requests(scope=None):
    """Open PRs where your review is requested. They aren't tied to a session, so the dashboard
    lists them on their own. None when off, or when gh is missing or fails."""
    query = REVIEW_SCOPES[scope or review_scope()]
    if not query or not shutil.which("gh"):
        return None
    try:
        r = subprocess.run(["gh", "search", "prs", query, "--state=open", "--limit", "30",
                            "--json", "number,title,url,repository,author,isDraft,updatedAt"],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    try:
        items = json.loads(r.stdout)
    except ValueError:
        return None
    out = []
    for d in items if isinstance(items, list) else []:
        if not isinstance(d, dict) or not isinstance(d.get("url"), str):
            continue
        repo, author = d.get("repository") or {}, d.get("author") or {}
        out.append({"url": d["url"], "number": d.get("number"), "title": d.get("title") or "",
                    "repo": repo.get("nameWithOwner") or repo.get("name") or "",
                    "author": author.get("login") or "", "draft": bool(d.get("isDraft")),
                    "updated": parse_ts(d.get("updatedAt")) or 0})
    out.sort(key=lambda x: -x["updated"])
    return out


def gh_viewer():
    """The GitHub login gh is signed in as, or None."""
    try:
        r = subprocess.run(["gh", "api", "user", "--jq", ".login"], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() or None if r.returncode == 0 else None


def review_requests(sessions, items=None, viewer=None):
    """Cached review requests, less PRs that one of your sessions made. Nothing while the cache
    was fetched for another setting (the PR loop fetches again within seconds), or, given a viewer,
    for another GitHub account: one account's requests never sit next to another's PRs."""
    own = {p["url"] for s in sessions for p in s.get("pr_details") or [] if p.get("own")}
    cache = load_json(REVIEWS_FILE, {}) or {}
    if items is None and cache.get("scope", "all") != review_scope():
        return []
    if items is None and viewer and cache.get("viewer") != viewer:  # another account's, or nobody knows whose
        return []
    items = (cache.get("items") or []) if items is None else items
    return [r for r in items if r.get("url") not in own]


# Authored search is capped; expose GitHub pagination state to both consumers.
PR_PLAN_QUERY = """query {
  viewer { login }
  mine: search(type: ISSUE, query: "is:pr is:open author:@me archived:false", first: 100) { pageInfo { hasNextPage } nodes { ... on PullRequest {
    url number title isDraft updatedAt headRefName baseRefName mergeStateStatus reviewDecision
    headRepository { nameWithOwner }
    repository { nameWithOwner defaultBranchRef { name } } author { login }
    commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
    reviewThreads(first: 100) { pageInfo { hasNextPage endCursor } nodes { isResolved comments(last: 1) { nodes { author { login } } } } }
  } } }
}"""
ROLLUP = {"SUCCESS": "passing", "FAILURE": "failing", "ERROR": "failing", "PENDING": "pending", "EXPECTED": "pending"}
STALE_AFTER = 14 * 86400


def fetch_pr_plan():
    """Your open PRs with CI, merge state and who spoke last on each open review thread, in one
    GraphQL call (about 50 points for 20 PRs). Off with CCDECK_PR_PLAN=0."""
    global _plan_state
    if os.environ.get("CCDECK_PR_PLAN") == "0" or not shutil.which("gh"):
        return None
    try:
        r = subprocess.run(["gh", "api", "graphql", "-f", "query=" + PR_PLAN_QUERY],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        _plan_state = "auth_required" if any(word in r.stderr.lower() for word in ("auth login", "authentication", "401", "not logged")) else "failed"
        return None
    try:
        data = json.loads(r.stdout)["data"]
        # one budget for every extra page: past it, PRs keep hasNextPage, read as "maybe more", never Merge
        deadline = time.monotonic() + 45
        for node in (data.get("mine") or {}).get("nodes") or []:
            if not isinstance(node, dict):
                continue
            threads = node.get("reviewThreads") or {}
            seen = set()
            while (threads.get("pageInfo") or {}).get("hasNextPage"):
                cursor = (threads.get("pageInfo") or {}).get("endCursor")
                left = deadline - time.monotonic()
                if not cursor or cursor in seen or left < 1:
                    break
                seen.add(cursor)
                query = """query($url: URI!, $cursor: String!) {
                  resource(url: $url) { ... on PullRequest {
                    reviewThreads(first: 100, after: $cursor) {
                      pageInfo { hasNextPage endCursor }
                      nodes { isResolved comments(last: 1) { nodes { author { login } } } }
                    }
                  } }
                }"""
                try:
                    page = subprocess.run(["gh", "api", "graphql", "-f", "query=" + query,
                                           "-f", "url=" + node["url"], "-f", "cursor=" + cursor],
                                          capture_output=True, text=True, timeout=min(30, left))
                except (OSError, subprocess.SubprocessError):
                    break  # retain the authored rows with an explicitly unknown review status
                try:
                    more = json.loads(page.stdout)["data"]["resource"]["reviewThreads"] if page.returncode == 0 else None
                    if not isinstance(more, dict) or not isinstance(more.get("nodes"), list) or not isinstance(more.get("pageInfo", {}).get("hasNextPage"), bool):
                        break
                    threads.setdefault("nodes", []).extend(more["nodes"])
                    threads["pageInfo"] = more["pageInfo"]
                except (ValueError, KeyError, TypeError, AttributeError):
                    break
        return parse_pr_plan(data)
    except (ValueError, KeyError, TypeError, AttributeError):
        return None


_plan_state = "pending"


def refresh_pr_plan():
    """Serialize observations across daemon and CLI processes; cache writes are best effort."""
    global _plan_state
    if os.environ.get("CCDECK_PR_PLAN") == "0":
        _plan_state = "disabled"
        return None
    lock = None
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        DATA_DIR.chmod(0o700)
        fd = os.open(DATA_DIR / "pr-plan.lock", os.O_CREAT | os.O_RDWR, 0o600)
        lock = os.fdopen(fd, "w")
        fcntl.flock(lock, fcntl.LOCK_EX)
    except OSError as e:
        if lock:
            lock.close()
            lock = None
        print(f"Warning: PR cache lock unavailable: {e}", file=sys.stderr)
    try:
        _plan_state = "pending"
        plan = fetch_pr_plan()
        if plan is None:
            _plan_state = "auth_required" if _plan_state == "auth_required" else "failed"
            return None
        plan = dict(plan, fetched=time.time())
        saved = False
        if lock:
            try:
                save_json(PR_PLAN_FILE, plan)
                saved = True
            except OSError as e:
                print(f"Warning: could not save PR plan: {e}", file=sys.stderr)
        # the dashboard reads the file: it's only "ready" once the fresh plan is in it
        _plan_state = "ready" if saved else "failed"
        return plan
    finally:
        if lock:
            lock.close()


def parse_pr_plan(d):
    """GraphQL data -> {"viewer", "prs"}."""
    viewer = (d.get("viewer") or {}).get("login") or ""
    prs = []
    for n in (d.get("mine") or {}).get("nodes") or []:
        if not isinstance(n, dict) or not isinstance(n.get("url"), str):
            continue
        repo = n.get("repository") or {}
        commit = (((n.get("commits") or {}).get("nodes") or [{}])[0] or {}).get("commit") or {}
        rollup = (commit.get("statusCheckRollup") or {}).get("state")
        last = [((((t.get("comments") or {}).get("nodes") or [{}])[0] or {}).get("author") or {}).get("login")
                for t in (n.get("reviewThreads") or {}).get("nodes") or [] if not t.get("isResolved")]
        prs.append({
            "url": n["url"], "number": n.get("number"), "title": n.get("title") or "",
            "repo": repo.get("nameWithOwner") or "", "draft": bool(n.get("isDraft")),
            "updated": parse_ts(n.get("updatedAt")) or 0,
            "head_repo": (n.get("headRepository") or {}).get("nameWithOwner") or "",
            "head": n.get("headRefName") or "", "base": n.get("baseRefName") or "",
            "default_base": (repo.get("defaultBranchRef") or {}).get("name") or "",
            "merge": (n.get("mergeStateStatus") or "unknown").lower(),  # clean | blocked | behind | dirty | unstable | unknown
            "review": (n.get("reviewDecision") or "").lower(),
            "checks": ROLLUP.get(rollup, "none") if rollup else "none",
            # someone else spoke last: work for the author; you did: only you can resolve the thread
            "threads": sum(1 for a in last if a != viewer), "threads_yours": sum(1 for a in last if a == viewer),
            "threads_more": bool((((n.get("reviewThreads") or {}).get("pageInfo")) or {}).get("hasNextPage")),
        })
    return {"viewer": viewer, "prs": prs, "truncated": bool(((d.get("mine") or {}).get("pageInfo") or {}).get("hasNextPage"))}


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


def pr_step(p, stacked_on=None, session=None, now=None, working=False):
    """(step, texts, who) for one of your open PRs. Steps: 1 merge, 2 fix, 4 waiting, 5 clean up
    (3, review, is for review requests). stacked_on: the open PR whose branch this one targets.
    session: name of a running session that owns the PR; it gets the fixes. working: that session is busy
    right now (not waiting for you). who: "you", "session" (the owning session) or None (nobody yet)."""
    days = int(((now or time.time()) - p["updated"]) // 86400)
    stale = [f"No activity for {days} days: close or pick up"] if days * 86400 >= STALE_AFTER else None
    if p["draft"]:
        # a draft is yours to look over, unless its session is still writing it
        if session and working:
            return 4, ["Draft: the session is working on it"], None
        return (5, ["Draft. " + stale[0]], "you") if stale and not session else (2, ["Draft: look it over, then mark it ready"], "you")
    fix = []
    if p["checks"] == "failing":
        fix.append("CI failing")
    if p["merge"] == "dirty":
        fix.append(f"Conflicts with {p['base']}")
    if p["review"] == "changes_requested":
        fix.append("Changes requested")
    if p["threads"]:  # known work stays work even when a later page of threads couldn't be read
        fix.append(plural(p["threads"], "review comment") + " to answer" + (", maybe more" if p.get("threads_more") else ""))
    if fix:
        # untouched for weeks and no session on it: decide its fate before fixing it
        return (5, stale + fix, "you") if stale and not session else (2, fix, "session" if session else "you")
    if p.get("threads_more"):
        return 4, ["Review status unknown: check GitHub"], None
    if p["merge"] == "blocked" and p["threads_yours"]:
        return 2, ["Resolve " + plural(p["threads_yours"], "thread"), "Waiting for a review or a required check"], "you"
    if stacked_on:
        wait = f"After #{stacked_on} merges"
    elif p["checks"] == "pending":
        wait = "CI running"
    elif p["merge"] == "blocked":
        wait = "Waiting for a review or a required check"
    elif p["merge"] not in ("clean", "has_hooks", "unstable", "behind"):
        wait = "GitHub is still checking whether it can merge"
    else:
        texts = ["Resolve " + plural(p["threads_yours"], "thread")] if p["threads_yours"] else []
        if p["merge"] == "behind":
            texts.append("Update the branch")
        return 1, texts + ["Merge it"], "you"
    return (5, stale, "you") if stale else (4, [wait], None)


def pr_key(url):
    """A PR's identity for joins: GitHub owner and repo names are case-insensitive."""
    return str(url).lower().rstrip("/")


def pr_plan(sessions, saved=None, reviews=None):
    """Your saved PRs with their step, who acts and the owning session (`own` in pr_details), plus
    review requests as step 3."""
    disabled = os.environ.get("CCDECK_PR_PLAN") == "0"
    saved = {} if disabled else (load_json(PR_PLAN_FILE, {}) if saved is None else saved)
    saved = saved or {}
    required = {"url", "repo", "head", "base", "default_base", "number", "title", "draft", "checks", "merge", "review", "threads", "threads_yours", "updated"}
    cached_prs = saved.get("prs")
    prs = [p for p in (cached_prs if isinstance(cached_prs, list) else []) if isinstance(p, dict) and required <= p.keys()
           and all(isinstance(p[k], str) for k in ("url", "repo", "head", "base", "default_base", "checks", "merge", "review"))
           and all(isinstance(p[k], (int, float)) for k in ("threads", "threads_yours", "updated"))]
    by_key = {pr_key(p["url"]): p for p in prs}
    owner = {}  # GitHub names are case-insensitive: a transcript's Acme/App/pull/7 is the plan's acme/app/pull/7
    for session in sessions:
        for detail in session.get("pr_details") or []:
            key = pr_key(detail["url"])
            row = by_key.get(key) or {}
            owns = detail.get("own") or detail.get("source") == "created" or bool(row.get("head") and row["head"] == session.get("branch"))
            if owns and (key not in owner or session.get("alive")):
                owner[key] = session
    heads = {(p.get("head_repo"), p["head"]): p["number"] for p in prs if p.get("head_repo")}
    rows = []
    for p in prs:
        s = owner.get(pr_key(p["url"]))
        name = (s.get("peer_name") or s["id"][:8]) if s else None
        stacked = heads.get((p["repo"], p["base"])) if p["base"] != p["default_base"] else None
        live = bool(s and s.get("alive"))
        step, texts, actor = pr_step(p, stacked, name if live else None, working=live and s.get("state") == "working")
        # actor: who acts, "you", "session" or None; who: what to call them (a session may be named "you")
        rows.append(dict(p, step=step, texts=texts, actor=actor, who=name if actor == "session" else actor, stacked_on=stacked, author=saved.get("viewer") or "",
                         session={"id": s["id"], "name": name, "alive": bool(s.get("alive"))} if s else None))
    mine = {pr_key(p["url"]) for p in prs}
    for r in review_requests([], reviews, saved.get("viewer")):
        if pr_key(r["url"]) not in mine:  # your own PR can be asked of a team you're in; it's already listed
            rows.append(dict(r, step=3, texts=["Review it"], actor="you", who="you", session=None))
    rows.sort(key=lambda r: (r["step"], r.get("updated") or 0))
    return {"fetched": saved.get("fetched"), "viewer": saved.get("viewer"), "rows": rows,
            "disabled": disabled, "truncated": saved.get("truncated", False), "state": "disabled" if disabled else _plan_state}


def pr_cache():
    with _pr_lock:
        return load_json(PR_CACHE_FILE, {})


def refresh_prs(urls, force=False):
    """Refresh stale entries for these PR urls. Returns True if anything changed."""
    cache = pr_cache()
    now, changed, fetched = time.time(), False, {}
    for url in urls:
        ent = cache.get(url) or {}
        data = ent.get("data") or {}
        if data.get("error"):
            ttl = 600
        elif data.get("state") in ("merged", "closed"):
            ttl = 6 * 3600
        elif data.get("checks") == "pending":
            ttl = 60
        else:
            ttl = 180
        if force or now - ent.get("fetched", 0) > ttl:
            new = fetch_pr(url)
            changed = changed or new != data
            fetched[url] = {"fetched": now, "data": new}
    if fetched:
        with _pr_lock:
            merged = load_json(PR_CACHE_FILE, {})
            merged.update(fetched)
            save_json(PR_CACHE_FILE, merged)
    return changed


def pr_info(url, cache):
    m = re.match(r"https://github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)", url)
    base = {"url": url, "repo": m.group(1) if m else "", "number": int(m.group(2)) if m else None}
    data = (cache.get(url) or {}).get("data") or {}
    if data.get("error"):
        base["error"] = data["error"]
    elif data:
        base.update(data)
    return base


def pr_details(s, cache):
    """The session's PRs, its own first: ones it created, or whose branch is the session's branch.
    PRs it only mentioned or looked up are kept, marked as related."""
    out = []
    for u in s.get("prs") or []:
        p = pr_info(u, cache)
        p["source"] = (s.get("pr_sources") or {}).get(u) or "claude"
        p["own"] = p["source"] == "created" or bool(p.get("head") and p["head"] == s.get("branch"))
        out.append(p)
    out.sort(key=lambda p: not p["own"])
    return out


