def gh_stack_dirs(cmd, cwd):
    """The folder each `gh stack` in a shell command runs in, following `cd`; [] if it runs none. It runs
    as a command's first word (after && || ; | a newline, or VAR=value words), not as quoted text such as
    `echo 'gh stack submit'`, whose output isn't gh stack's. A folder is None when it can't be told (`cd -`)."""
    if "gh" not in cmd or "stack" not in cmd:
        return []
    try:
        lex = shlex.shlex(cmd, posix=True, punctuation_chars=True)
        lex.whitespace = " \t"  # newlines separate commands
        words = list(lex)
    except ValueError:
        return []
    ops = ("&&", "||", ";", "|", "\n", "(", ")", "&")
    out, here, start, saved = [], cwd or None, True, []
    for i, w in enumerate(words):
        if w in ops:
            if w == "(":  # a subshell's cd ends with it: `(cd /b && make)` leaves the folder as it was
                saved.append(here)
            elif w == ")" and saved:
                here = saved.pop()
            start = True
            continue
        if start and w == "gh" and i + 1 < len(words) and words[i + 1] == "stack":
            out.append(here)
        elif start and w == "cd":
            arg = words[i + 1] if i + 1 < len(words) and words[i + 1] not in ops else "~"
            arg = os.path.expanduser(arg)
            here = None if arg == "-" or not (here or os.path.isabs(arg)) else os.path.normpath(os.path.join(here or "/", arg))
        elif start and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", w, re.S):
            continue  # `CI=1 gh stack submit`: assignments before the command keep its first word to come
        start = False
    return out


def runs_gh_stack(cmd):
    return bool(gh_stack_dirs(cmd, None))


_repo_cache = {}  # folder -> (owner/name or None, when): an answer is kept, a failure is asked again after a minute


def github_repo(cwd):
    """owner/name of the GitHub repo a folder's origin remote points at, or None."""
    if not cwd:
        return None
    hit = _repo_cache.get(cwd)
    if hit and (hit[0] or time.time() - hit[1] < 60):
        return hit[0]
    # an inherited GIT_DIR (a hook run inside another repo) would beat -C and answer for that repo
    env = {k: v for k, v in os.environ.items() if k not in GIT_LOCATION_VARS}
    try:
        out = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"], capture_output=True, text=True,
                             timeout=3, env=env).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    m = GITHUB_REMOTE_RE.fullmatch(out.strip())
    _repo_cache[cwd] = (m.group(1) if m else None, time.time())
    return _repo_cache[cwd][0]


def with_stack_prs(info):
    """The session with the PRs `gh stack submit` named, as links: each in the repo of the folder that
    command ran in. Resolved on every scan, not in the cached parse, so a failed lookup is tried again."""
    found = {}
    for cwd, n in info.get("stack_prs") or ():
        repo = github_repo(cwd)
        if repo:
            found[f"https://github.com/{repo}/pull/{n}"] = "created"
    if not found:
        return info
    sources = dict(info.get("pr_sources") or {}, **found)
    return dict(info, prs=list(dict.fromkeys(list(info.get("prs") or []) + list(found))), pr_sources=sources)


def parse_transcript(path):
    info = {
        "id": path.stem, "cwd": None, "branch": None, "title": None, "ai_title": None,
        "summary": None, "first_prompt": None, "last_prompt": None, "prompts": 0,
        "first_ts": 0.0, "last_ts": 0.0, "last_role": None, "last_text": "",
        "api_error": False, "entrypoint": None, "pending_tool": None, "pending_input": None, "pending_question": None, "pending_id": None, "prs": [], "links": {}, "files": [],
        "refs": [], "linear": {}, "issue_keys": [], "usage": empty_usage(), "context": 0, "model": None,
    }
    prs, files, tool_names, pending, pending_inputs = {}, {}, {}, {}, {}
    refs, linear, keys, tool_titles, not_created, questions = {}, {}, {}, {}, {}, {}
    stack_dirs = {}  # tool id -> the folder its gh stack ran in (None: several, or unknown)
    stack_prs = {}  # (folder, PR number) that `gh stack submit` printed, without links; with_stack_prs resolves them
    seen_msgs = set()

    def note_ref(url, kind, title, source):
        r = refs.get(url)
        start = source == "you" and info["prompts"] == 0  # shared in the prompt that started the session
        if r is None:
            refs[url] = {"url": url, "kind": kind, "title": title or (notion_title(url) if kind == "notion" else None),
                         "source": source, "start": start}
            return
        r["start"] = r.get("start") or start
        if title and not r["title"]:
            r["title"] = title
        if SOURCE_RANK[source] > SOURCE_RANK[r["source"]]:
            r["source"] = source

    def note_issue(key, url, title, source):
        key = key.upper()
        r = linear.setdefault(key, {"key": key, "url": None, "title": None, "source": source, "start": False})
        r["start"] = r["start"] or (source == "you" and info["prompts"] == 0)
        r["url"] = r["url"] or url
        r["title"] = r["title"] or title
        if SOURCE_RANK[source] > SOURCE_RANK[r["source"]]:
            r["source"] = source

    def add_refs(text, source, with_prs=False):
        if not text:
            return
        if with_prs:
            for m in PR_RE.findall(text):
                if prs.get(m) != "created":
                    prs[m] = source
        for kind, rx in REF_RES:
            for m in rx.findall(text):
                note_ref(m.rstrip(").,;:]'\"`"), kind, None, source)
        for ws, key, slug in LINEAR_URL_RE.findall(text):
            note_issue(key, f"https://linear.app/{ws}/issue/{key.upper()}", slug_title(slug) if slug else None, source)
        if source in ("you", "claude"):
            for a, b in ISSUE_KEY_RE.findall(text):
                keys.setdefault(f"{a}-{b}", None)

    def add_json_titles(text, source):
        for o in json_objects(text):
            url = o.get("url") or o.get("link") or o.get("href")
            title = o.get("title") or o.get("name")
            ident = o.get("identifier")
            title = title if isinstance(title, str) else None
            if isinstance(ident, str) and ISSUE_KEY_RE.fullmatch(ident.upper()):
                note_issue(ident, url if isinstance(url, str) and "linear.app" in url else None, title, source)
            elif isinstance(url, str) and title:
                for kind, rx in REF_RES:
                    if rx.match(url):
                        note_ref(url, kind, title, source)

    try:
        f = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return info
    with f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if not isinstance(e, dict):
                continue
            t = e.get("type")
            if t == "custom-title":
                info["title"] = e.get("customTitle") or info["title"]
                continue
            if t == "ai-title":
                info["ai_title"] = e.get("aiTitle") or info["ai_title"]
                continue
            if t == "summary":
                info["summary"] = e.get("summary") or info["summary"]
                continue
            if t == "pr-link":  # Claude Code's own record of a PR it linked to this session
                url = e.get("prUrl")
                if isinstance(url, str) and PR_RE.fullmatch(url):
                    prs[url] = "created"
                continue
            if t not in ("user", "assistant") or e.get("isSidechain"):
                continue
            ts = parse_ts(e.get("timestamp"))
            if ts:
                info["first_ts"] = info["first_ts"] or ts
                info["last_ts"] = max(info["last_ts"], ts)
            info["cwd"] = e.get("cwd") or info["cwd"]
            info["branch"] = e.get("gitBranch") or info["branch"]
            info["entrypoint"] = e.get("entrypoint") or info["entrypoint"]  # the latest: a resume can change it
            content = message_content(e)

            if t == "user":
                if isinstance(content, list):
                    for b in content:
                        if isinstance(b, dict) and b.get("type") == "tool_result":
                            tid = b.get("tool_use_id")
                            pending.pop(tid, None)
                            name = tool_names.get(tid, "")
                            body = block_text(b.get("content"))
                            for u in not_created.pop(tid, ()):  # the type an artifact was made from isn't ours
                                body = body.replace(u, "")
                            creating = any(h in name for h in CREATING_TOOL_HINTS)
                            if creating or "linear" in name.lower():
                                src = "created" if creating else "tool"
                                add_refs(body, src, with_prs=creating)
                                if name == "Bash:stack":
                                    for x, y in STACK_PR_RE.findall(body) if stack_dirs.get(tid) else ():
                                        stack_prs[(stack_dirs[tid], int(x or y))] = None
                                add_json_titles(body, src)
                                if tid in tool_titles:  # an Artifact publish: title from its own input
                                    for r in refs.values():
                                        if r["kind"] == "artifact" and not r["title"] and r["url"] in body:
                                            r["title"] = tool_titles[tid]
                if is_real_prompt(e):
                    text = block_text(content)
                    add_refs(text, "you")
                    info["prompts"] += 1
                    info["first_prompt"] = info["first_prompt"] or text
                    info["last_prompt"] = text
                    info["last_role"] = "user"
                    info["last_text"] = text
                    info["api_error"] = False
                continue

            usage, model = assistant_usage(e, seen_msgs)
            if usage:
                add_usage(info["usage"], usage)
                ctx = context_of(usage)
                if ctx:
                    info["context"] = ctx
                info["model"] = model or info["model"]
            if not isinstance(content, list):
                continue
            info["api_error"] = bool(e.get("isApiErrorMessage") or e.get("error"))
            for b in content:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text", "").strip():
                    info["last_role"] = "assistant"
                    info["last_text"] = b["text"]
                    add_refs(b["text"], "claude", with_prs=True)
                elif b.get("type") == "tool_use":
                    name = b.get("name", "")
                    inp = b.get("input") if isinstance(b.get("input"), dict) else {}
                    tool_names[b.get("id")] = name
                    pending[b.get("id")] = name
                    pending_inputs[b.get("id")] = summarize_tool_input(name, inp)
                    if name == "AskUserQuestion":  # every question, whole: the bell keeps the full text
                        raw = inp.get("questions")
                        qs = [q.get("question") for q in (raw if isinstance(raw, list) else []) if isinstance(q, dict)]
                        questions[b.get("id")] = "\n\n".join(str(q) for q in qs if q) or None
                    info["last_role"] = "tool"
                    if "linear" in name.lower():
                        for v in inp.values():
                            if isinstance(v, str) and ISSUE_KEY_RE.fullmatch(v.upper()):
                                note_issue(v, None, None, "tool")
                    if name == "Artifact" and inp.get("action", "publish") != "publish":
                        # quickstart, list, read, open...: their results name other accounts'
                        # artifacts (Artifact types, shared pages), never one this session made
                        tool_names[b.get("id")] = "artifact-lookup"
                    elif name == "Artifact":
                        theirs = [inp[k] for k in ("type_url", "from_url") if isinstance(inp.get(k), str)]
                        if theirs:
                            not_created[b.get("id")] = theirs
                    if name == "Artifact" or name.endswith("__create"):
                        t = inp.get("title") or inp.get("name")
                        if isinstance(t, str) and t.strip():
                            tool_titles[b.get("id")] = t.strip()[:120]
                    if name in WRITE_TOOLS:
                        fp = inp.get("file_path") or inp.get("notebook_path")
                        if isinstance(fp, str):
                            files[fp] = None
                    elif name == "Bash":
                        cmd = str(inp.get("command", ""))
                        dirs = gh_stack_dirs(cmd, e.get("cwd") or info["cwd"])
                        if dirs:
                            tool_names[b.get("id")] = "Bash:stack"
                            # its number-only lines belong to the folder it ran in; two folders can't be told apart
                            same = {os.path.realpath(d) if d else None for d in dirs}  # /var/x is /private/var/x
                            stack_dirs[b.get("id")] = dirs[0] if len(same) == 1 and None not in same else None
                        elif "gh pr create" in cmd or "git push" in cmd:
                            tool_names[b.get("id")] = "Bash:create"
    info["pending_tool"] = list(pending.values())[-1] if pending else None
    info["pending_input"] = pending_inputs.get(list(pending)[-1]) if pending else None
    info["pending_question"] = questions.get(list(pending)[-1]) if pending else None
    info["pending_id"] = list(pending)[-1] if pending else None
    info["stack_prs"] = [[cwd, n] for cwd, n in stack_prs if cwd]
    info["prs"] = list(prs)
    info["pr_sources"] = dict(prs)
    for r in refs.values():
        r["primary"] = bool(r.get("start") or r["source"] == "created")
    info["refs"] = list(refs.values())
    info["linear"] = linear
    info["issue_keys"] = [k for k in keys if k not in linear]
    links = {}
    for r in info["refs"]:
        links.setdefault(r["kind"], []).append(r["url"])
    for r in linear.values():
        if r["url"]:
            links.setdefault("linear", []).append(r["url"])
    info["links"] = links
    info["files"] = list(files)
    return info


_scan_lock = threading.Lock()


def scan_transcripts():
    with _scan_lock:
        cache = load_json(CACHE_FILE, {})
        if cache.get("v") != CACHE_VERSION:
            cache = {"v": CACHE_VERSION, "files": {}}
        entries = cache["files"]
        seen, sessions, dirty = set(), {}, False
        if PROJECTS_DIR.is_dir():
            for path in PROJECTS_DIR.glob("*/*.jsonl"):
                try:
                    st = path.stat()
                except OSError:
                    continue
                key = str(path)
                seen.add(key)
                sig = [st.st_mtime, st.st_size]
                hit = entries.get(key)
                if hit and hit.get("sig") == sig:
                    info = hit["info"]
                else:
                    info = parse_transcript(path)
                    entries[key] = {"sig": sig, "info": info}
                    dirty = True
                if info["prompts"] == 0:
                    continue
                prev = sessions.get(info["id"])
                if not prev or info["last_ts"] > prev["last_ts"]:
                    sessions[info["id"]] = dict(with_stack_prs(info))
            sub_usage = {}
            for path in PROJECTS_DIR.glob("*/*/subagents/*.jsonl"):
                try:
                    st = path.stat()
                except OSError:
                    continue
                key = str(path)
                seen.add(key)
                sig = [st.st_mtime, st.st_size]
                hit = entries.get(key)
                if hit and hit.get("sig") == sig and "usage" in hit:
                    u = hit["usage"]
                else:
                    u = parse_usage_only(path)
                    entries[key] = {"sig": sig, "usage": u}
                    dirty = True
                agg = sub_usage.setdefault(path.parent.parent.name, empty_usage())
                for k in agg:
                    agg[k] += u.get(k, 0)
            for sid, u in sub_usage.items():
                if sid in sessions:
                    sessions[sid]["sub_usage"] = u
        for k in list(entries):
            if k not in seen:
                del entries[k]
                dirty = True
        if dirty:
            try:
                save_json(CACHE_FILE, cache)
            except OSError:
                pass
        return sessions


