PR_STEPS = {1: "MERGE", 2: "FIX", 3: "REVIEW", 4: "WAITING", 5: "CLEAN UP"}


def cmd_prs(args):
    # Invocation-local results: CLI credentials may differ from the daemon's credentials.
    plan = fetch_pr_plan()
    unavailable = plan is None and os.environ.get("CCDECK_PR_PLAN") != "0"
    if unavailable:
        print("Authored PR list unavailable; check gh auth login.", file=sys.stderr)
    scope = review_scope()
    items = fetch_review_requests(scope)
    if items is None and scope != "off":
        unavailable = True  # an empty list would claim nobody asked for your review
        print("Review requests unavailable; check gh auth login.", file=sys.stderr)
    assembled = pr_plan(collect(include_all=True, days=10 ** 6),
                        saved=dict(plan, fetched=time.time()) if plan is not None else {}, reviews=items or [])
    rows = assembled["rows"]
    if assembled["truncated"]:
        print("Warning: authored PRs limited to the first 100 results; stack targets may be missing.", file=sys.stderr)
    if args.sessions:
        rows = [r for r in rows if r["session"] or r["step"] == 3]
    if not rows:
        print("No available PR data." if unavailable else "No open PRs.")
    width = shutil.get_terminal_size((120, 20)).columns
    for step, label in PR_STEPS.items():
        part = [r for r in rows if r["step"] == step]
        if not part:
            continue
        print("\n" + bold(f"{step}. {label}") + dim(f"  {len(part)}"))
        for r in part:
            who, s = r["who"] or "", r["session"]
            print(f"  {r['repo']}#{r['number']}  {one_line(r['title'], max(20, width - 70))}")
            print(dim("      " + " · ".join(r["texts"]) + (f"  → {who}" if who else "")
                      + (f"  [@{s['name']}]" if s and s["name"] != who else "")))


UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")


def resolve(ref, allow_unknown=False):
    if ref.isdigit() and len(ref) < 4:
        listed = load_json(LAST_LIST_FILE, [])
        i = int(ref) - 1
        if 0 <= i < len(listed) and isinstance(listed[i], str):
            ref = listed[i]
    rows = collect(include_all=True, days=10 ** 6)
    hits = [r for r in rows if r["id"].startswith(ref)]
    if not hits and allow_unknown and UUID_RE.fullmatch(ref):
        # e.g. /ccdeck:done in a session whose first prompt isn't saved yet
        return {"id": ref, "title": "this session", "mark": {}}
    if not hits:
        sys.exit(f"No session matches '{ref}'.")
    if len(hits) > 1:
        sys.exit(f"'{ref}' is ambiguous: " + ", ".join(h["id"][:12] for h in hits))
    return hits[0]


def cmd_show(args):
    s = resolve(args.id)
    if s["prs"] and not args.no_gh:
        refresh_prs(s["prs"], force=True)
        s["pr_details"] = pr_details(s, pr_cache())
    m = s["mark"]
    print(bold(title_of(s)))
